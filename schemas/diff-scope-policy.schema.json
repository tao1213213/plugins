{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor.com/schemas/diff-scope-policy.schema.json",
  "title": "Diff scope policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "allowed", "forbidden"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "allowed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
